# ============================================================
# LegalMetriCheck — Environment Variables Configuration
# ============================================================

# --- Application URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database Configuration ---
# Local standalone MongoDB:
MONGODB_URI=mongodb://localhost:27017/legalmetricheck
# Or MongoDB Atlas Cloud:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/legalmetricheck?retryWrites=true&w=majority

# --- Cryptographic Session Security ---
SESSION_SECRET=legalmetricheck-enclave-session-secret-2026-production

# --- Optional AI/OCR Integrations ---
# Google Gemini API Key (optional fallback for advanced multi-lingual label understanding):
# GEMINI_API_KEY=your_gemini_api_key_here
